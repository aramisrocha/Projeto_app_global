import React, { useEffect, useMemo, useState } from "react";

const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || "https://SEU-ENDPOINT-API";
import { motion } from "framer-motion";
import { Clock3, ShieldCheck, UserPlus, FileText, ArrowLeft, LogIn, Fingerprint } from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";

function formatDate(date) {
  return new Intl.DateTimeFormat("pt-BR", {
    weekday: "long",
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);
}

function formatTime(date) {
  return new Intl.DateTimeFormat("pt-BR", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  }).format(date);
}

export default function SistemaPontoFrontend() {
  const [currentTime, setCurrentTime] = useState(new Date());
  const [screen, setScreen] = useState("home");
  const [employeeId, setEmployeeId] = useState("");
  const [password, setPassword] = useState("");
  const [adminUser, setAdminUser] = useState("");
  const [adminPass, setAdminPass] = useState("");
  const [message, setMessage] = useState("");
  const [loadingPoint, setLoadingPoint] = useState(false);
  const [loadingAdmin, setLoadingAdmin] = useState(false);
  const [employees, setEmployees] = useState([]);
  const [reports, setReports] = useState([]);
  const [employeeForm, setEmployeeForm] = useState({
    nome: "",
    matricula: "",
    email: "",
    status: "Ativo",
  });

  useEffect(() => {
    const timer = setInterval(() => setCurrentTime(new Date()), 1000);
    async function loadEmployees(tokenParam) {
    try {
      const token = tokenParam || localStorage.getItem("admin_token");
      const response = await fetch(`${API_BASE_URL}/employees`, {
        headers: {
          "Content-Type": "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
      });

      if (!response.ok) {
        throw new Error("Falha ao carregar funcionários.");
      }

      const data = await response.json();
      setEmployees(Array.isArray(data) ? data : data.items || []);
    } catch (error) {
      console.error(error);
    }
  }

  async function loadReports(tokenParam) {
    try {
      const token = tokenParam || localStorage.getItem("admin_token");
      const response = await fetch(`${API_BASE_URL}/reports`, {
        headers: {
          "Content-Type": "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
      });

      if (!response.ok) {
        throw new Error("Falha ao carregar relatórios.");
      }

      const data = await response.json();
      setReports(Array.isArray(data) ? data : data.items || []);
    } catch (error) {
      console.error(error);
    }
  }

  async function handleEmployeeSave(e) {
    e.preventDefault();
    setMessage("");

    try {
      const token = localStorage.getItem("admin_token");
      const response = await fetch(`${API_BASE_URL}/employees`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        body: JSON.stringify(employeeForm),
      });

      if (!response.ok) {
        throw new Error("Falha ao salvar cadastro.");
      }

      setMessage("Funcionário cadastrado com sucesso.");
      setEmployeeForm({ nome: "", matricula: "", email: "", status: "Ativo" });
      await loadEmployees();
    } catch (error) {
      setMessage(error.message || "Erro ao salvar funcionário.");
    }
  }

  useEffect(() => {
    if (screen === "admin-dashboard") {
      loadEmployees();
      loadReports();
    }
  }, [screen]);

  return () => clearInterval(timer);
  }, []);

  const dateLabel = useMemo(() => formatDate(currentTime), [currentTime]);
  const timeLabel = useMemo(() => formatTime(currentTime), [currentTime]);

  async function handlePointRegister(e) {
    e.preventDefault();
    setLoadingPoint(true);
    setMessage("");

    try {
      const response = await fetch(`${API_BASE_URL}/clock`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          employee_id: employeeId,
          password,
        }),
      });

      if (!response.ok) {
        throw new Error("Falha ao registrar ponto.");
      }

      const data = await response.json().catch(() => ({}));
      setMessage(data.message || `Ponto registrado com sucesso às ${timeLabel}.`);
      setEmployeeId("");
      setPassword("");
      await loadReports();
    } catch (error) {
      setMessage(error.message || "Erro ao registrar ponto.");
    } finally {
      setLoadingPoint(false);
    }
  }

  async function handleAdminLogin(e) {
    e.preventDefault();
    setLoadingAdmin(true);
    setMessage("");

    try {
      const response = await fetch(`${API_BASE_URL}/admin/login`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          username: adminUser,
          password: adminPass,
        }),
      });

      if (!response.ok) {
        throw new Error("Falha no login administrativo.");
      }

      const data = await response.json();
      if (data?.token) {
        localStorage.setItem("admin_token", data.token);
      }

      setMessage("Login realizado com sucesso.");
      setScreen("admin-dashboard");
      await Promise.all([loadEmployees(data?.token), loadReports(data?.token)]);
    } catch (error) {
      setMessage(error.message || "Erro ao autenticar administrador.");
    } finally {
      setLoadingAdmin(false);
    }
  }

  return (
    <div className="min-h-screen bg-slate-100 p-4 md:p-8">
      <div className="mx-auto max-w-7xl">
        <motion.div
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.4 }}
          className="mb-6 flex items-center justify-between"
        >
          <div>
            <h1 className="text-3xl font-bold tracking-tight text-slate-900">Sistema de Ponto</h1>
            <p className="mt-1 text-sm text-slate-600">Protótipo de frontend para registro de ponto e acesso administrativo</p>
          </div>

          {screen !== "home" && (
            <Button variant="outline" className="rounded-2xl" onClick={() => setScreen("home")}>
              <ArrowLeft className="mr-2 h-4 w-4" /> Voltar
            </Button>
          )}
        </motion.div>

        {screen === "home" && (
          <div className="grid gap-6 lg:grid-cols-[1.3fr_0.9fr]">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.05, duration: 0.4 }}
            >
              <Card className="rounded-3xl border-0 shadow-lg">
                <CardContent className="flex min-h-[420px] flex-col items-center justify-center p-8 text-center">
                  <div className="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-slate-900 text-white shadow-md">
                    <Clock3 className="h-10 w-10" />
                  </div>
                  <p className="mb-2 text-sm uppercase tracking-[0.2em] text-slate-500">Horário atual</p>
                  <h2 className="text-6xl font-bold tracking-tight text-slate-900 md:text-7xl">{timeLabel}</h2>
                  <p className="mt-4 text-lg capitalize text-slate-600">{dateLabel}</p>
                  <div className="mt-8 max-w-xl rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
                    Nesta tela inicial você pode exibir o relógio em tempo real e o acesso rápido para registrar ponto. Depois, o formulário pode enviar matrícula e senha para sua API.
                  </div>
                </CardContent>
              </Card>
            </motion.div>

            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.12, duration: 0.4 }}
              className="space-y-6"
            >
              <Card className="rounded-3xl border-0 shadow-lg">
                <CardHeader>
                  <div className="mb-3 flex items-center justify-between">
                    <CardTitle className="text-xl">Ações rápidas</CardTitle>
                    <Button
                      variant="secondary"
                      className="rounded-2xl"
                      onClick={() => setScreen("admin-login")}
                    >
                      <ShieldCheck className="mr-2 h-4 w-4" />
                      Acesso administrativo
                    </Button>
                  </div>
                  <p className="text-sm text-slate-600">
                    O botão administrativo fica no canto superior esquerdo da interface final. Aqui ele foi mantido em destaque para facilitar a visualização do fluxo.
                  </p>
                </CardHeader>
                <CardContent>
                  <form onSubmit={handlePointRegister} className="space-y-4">
                    <div className="space-y-2">
                      <Label htmlFor="employeeId">Matrícula</Label>
                      <Input
                        id="employeeId"
                        placeholder="Digite sua matrícula"
                        value={employeeId}
                        onChange={(e) => setEmployeeId(e.target.value)}
                        className="rounded-2xl"
                      />
                    </div>
                    <div className="space-y-2">
                      <Label htmlFor="password">Senha</Label>
                      <Input
                        id="password"
                        type="password"
                        placeholder="Digite sua senha"
                        value={password}
                        onChange={(e) => setPassword(e.target.value)}
                        className="rounded-2xl"
                      />
                    </div>
                    <Button type="submit" className="w-full rounded-2xl py-6 text-base" disabled={loadingPoint}>
                      <Fingerprint className="mr-2 h-4 w-4" />
                      {loadingPoint ? "Registrando..." : "Registrar ponto"}
                    </Button>
                  </form>
                </CardContent>
              </Card>

              {message && (
                <Card className="rounded-3xl border-0 shadow-lg">
                  <CardContent className="p-5 text-sm text-slate-700">{message}</CardContent>
                </Card>
              )}
            </motion.div>
          </div>
        )}

        {screen === "admin-login" && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.35 }}
            className="mx-auto max-w-xl"
          >
            <Card className="rounded-3xl border-0 shadow-lg">
              <CardHeader>
                <CardTitle className="flex items-center gap-2 text-2xl">
                  <LogIn className="h-6 w-6" />
                  Acesso administrativo
                </CardTitle>
                <p className="text-sm text-slate-600">
                  Esta etapa futuramente pode ser integrada ao AWS Cognito para autenticação segura dos usuários administradores.
                </p>
              </CardHeader>
              <CardContent>
                <form onSubmit={handleAdminLogin} className="space-y-4">
                  <div className="space-y-2">
                    <Label htmlFor="adminUser">Usuário</Label>
                    <Input
                      id="adminUser"
                      placeholder="Digite o usuário administrativo"
                      value={adminUser}
                      onChange={(e) => setAdminUser(e.target.value)}
                      className="rounded-2xl"
                    />
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="adminPass">Senha</Label>
                    <Input
                      id="adminPass"
                      type="password"
                      placeholder="Digite a senha"
                      value={adminPass}
                      onChange={(e) => setAdminPass(e.target.value)}
                      className="rounded-2xl"
                    />
                  </div>
                  <Button type="submit" className="w-full rounded-2xl py-6 text-base" disabled={loadingAdmin}>
                    {loadingAdmin ? "Entrando..." : "Entrar"}
                  </Button>
                </form>
              </CardContent>
            </Card>
          </motion.div>
        )}

        {screen === "admin-dashboard" && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.35 }}
          >
            <Card className="rounded-3xl border-0 shadow-lg">
              <CardHeader>
                <CardTitle className="text-2xl">Painel administrativo</CardTitle>
                <p className="text-sm text-slate-600">
                  Exemplo de tela após autenticação. Aqui você pode evoluir para cadastro de funcionários, relatórios e integração com backend.
                </p>
              </CardHeader>
              <CardContent>
                <Tabs defaultValue="cadastro" className="w-full">
                  <TabsList className="mb-6 grid w-full grid-cols-2 rounded-2xl">
                    <TabsTrigger value="cadastro" className="rounded-2xl">
                      <UserPlus className="mr-2 h-4 w-4" /> Cadastro
                    </TabsTrigger>
                    <TabsTrigger value="relatorios" className="rounded-2xl">
                      <FileText className="mr-2 h-4 w-4" /> Relatórios
                    </TabsTrigger>
                  </TabsList>

                  <TabsContent value="cadastro">
                    <form onSubmit={handleEmployeeSave}>
                      <div className="grid gap-4 md:grid-cols-2">
                        <div className="space-y-2">
                          <Label htmlFor="nome">Nome do funcionário</Label>
                          <Input
                            id="nome"
                            placeholder="Ex.: João da Silva"
                            className="rounded-2xl"
                            value={employeeForm.nome}
                            onChange={(e) => setEmployeeForm((prev) => ({ ...prev, nome: e.target.value }))}
                          />
                        </div>
                        <div className="space-y-2">
                          <Label htmlFor="matriculaCadastro">Matrícula</Label>
                          <Input
                            id="matriculaCadastro"
                            placeholder="Ex.: 102030"
                            className="rounded-2xl"
                            value={employeeForm.matricula}
                            onChange={(e) => setEmployeeForm((prev) => ({ ...prev, matricula: e.target.value }))}
                          />
                        </div>
                        <div className="space-y-2">
                          <Label htmlFor="email">E-mail</Label>
                          <Input
                            id="email"
                            placeholder="funcionario@empresa.com"
                            className="rounded-2xl"
                            value={employeeForm.email}
                            onChange={(e) => setEmployeeForm((prev) => ({ ...prev, email: e.target.value }))}
                          />
                        </div>
                        <div className="space-y-2">
                          <Label htmlFor="status">Status</Label>
                          <Input
                            id="status"
                            placeholder="Ativo"
                            className="rounded-2xl"
                            value={employeeForm.status}
                            onChange={(e) => setEmployeeForm((prev) => ({ ...prev, status: e.target.value }))}
                          />
                        </div>
                      </div>
                      <div className="mt-6 flex justify-end">
                        <Button type="submit" className="rounded-2xl">Salvar cadastro</Button>
                      </div>
                    </form>

                    <div className="mt-8 overflow-hidden rounded-3xl border border-slate-200">
                      <table className="min-w-full text-sm">
                        <thead className="bg-slate-50 text-left text-slate-600">
                          <tr>
                            <th className="px-4 py-3">Nome</th>
                            <th className="px-4 py-3">Matrícula</th>
                            <th className="px-4 py-3">E-mail</th>
                            <th className="px-4 py-3">Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          {employees.length > 0 ? (
                            employees.map((item, index) => (
                              <tr key={item.id || item.matricula || index} className="border-t border-slate-200 bg-white">
                                <td className="px-4 py-3 text-slate-700">{item.nome || item.name}</td>
                                <td className="px-4 py-3 text-slate-700">{item.matricula || item.employee_id}</td>
                                <td className="px-4 py-3 text-slate-700">{item.email || "-"}</td>
                                <td className="px-4 py-3 text-slate-700">{item.status || "Ativo"}</td>
                              </tr>
                            ))
                          ) : (
                            <tr className="border-t border-slate-200 bg-white">
                              <td colSpan={4} className="px-4 py-6 text-center text-slate-500">
                                Nenhum funcionário carregado.
                              </td>
                            </tr>
                          )}
                        </tbody>
                      </table>
                    </div>
                  </TabsContent>

                  <TabsContent value="relatorios">
                    <div className="grid gap-4 lg:grid-cols-3">
                      <Card className="rounded-3xl border bg-slate-50 shadow-none">
                        <CardContent className="p-5">
                          <p className="text-sm text-slate-500">Registros carregados</p>
                          <h3 className="mt-2 text-3xl font-bold">{reports.length}</h3>
                        </CardContent>
                      </Card>
                      <Card className="rounded-3xl border bg-slate-50 shadow-none">
                        <CardContent className="p-5">
                          <p className="text-sm text-slate-500">Funcionários ativos</p>
                          <h3 className="mt-2 text-3xl font-bold">{employees.length}</h3>
                        </CardContent>
                      </Card>
                      <Card className="rounded-3xl border bg-slate-50 shadow-none">
                        <CardContent className="p-5">
                          <p className="text-sm text-slate-500">Endpoint</p>
                          <h3 className="mt-2 break-all text-base font-semibold">{API_BASE_URL}</h3>
                        </CardContent>
                      </Card>
                    </div>

                    <div className="mt-6 overflow-hidden rounded-3xl border border-slate-200">
                      <table className="min-w-full text-sm">
                        <thead className="bg-slate-50 text-left text-slate-600">
                          <tr>
                            <th className="px-4 py-3">Funcionário</th>
                            <th className="px-4 py-3">Matrícula</th>
                            <th className="px-4 py-3">Entrada</th>
                            <th className="px-4 py-3">Saída</th>
                            <th className="px-4 py-3">Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          {reports.length > 0 ? (
                            reports.map((row, index) => (
                              <tr key={row.id || index} className="border-t border-slate-200 bg-white">
                                <td className="px-4 py-3 text-slate-700">{row.nome || row.name || "-"}</td>
                                <td className="px-4 py-3 text-slate-700">{row.matricula || row.employee_id || "-"}</td>
                                <td className="px-4 py-3 text-slate-700">{row.entrada || row.check_in || "-"}</td>
                                <td className="px-4 py-3 text-slate-700">{row.saida || row.check_out || "-"}</td>
                                <td className="px-4 py-3 text-slate-700">{row.status || "-"}</td>
                              </tr>
                            ))
                          ) : (
                            <tr className="border-t border-slate-200 bg-white">
                              <td colSpan={5} className="px-4 py-6 text-center text-slate-500">
                                Nenhum relatório carregado.
                              </td>
                            </tr>
                          )}
                        </tbody>
                      </table>
                    </div>
                  </TabsContent>
                </Tabs>
              </CardContent>
            </Card>
          </motion.div>
        )}
      </div>
    </div>
  );
}
